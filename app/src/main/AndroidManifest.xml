<?xml version="1.0" encoding="utf-8"?>
<!--
  STONE - fully offline fitness, diet and workout tracker.

  Essentially all of the app is C: libstone.so is loaded by NativeActivity and
  drives everything through ANativeActivity_onCreate. The single Java class,
  StoneActivity, exists only because immersive mode and window insets have to
  be driven from the Activity's UI thread, which android_main() is not. See
  StoneActivity.java for the full reasoning.

  No INTERNET permission is declared anywhere on purpose: the app physically
  cannot reach the network.

  Created by sobing4413 - Exter Interactive.
-->
<!-- No package="..." here on purpose: from AGP 8 the namespace comes from
     app/build.gradle and declaring it in the manifest as well is an error. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stone">

        <activity
            android:name="com.stone.app.StoneActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:resizeableActivity="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode"
            android:theme="@style/Theme.Stone">

            <!-- Must match the CMake target name: libstone.so -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="stone" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
